# Configuración General del Servidor
HOST=127.0.0.1
PORT=8000
SECRET_KEY=super_secret_jwt_key_for_super_uce_doc_project_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos
DATABASE_URL=sqlite:///./super_uce_doc.db

# API para Chatbot Médico (OpenRouter con Gemini 2.5 Flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local LLM Config (Ollama Llama-3.1 8B RAG)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1
USE_LOCAL_LLM=False

# Tavily API (Búsqueda Web Profesional en Vivo para IA - Gratis 1000/mes en tavily.com)
TAVILY_API_KEY=

# Configuración de LiveKit (Teleconsulta)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=mi_super_secreto_largo_para_livekit_de_32_letras
