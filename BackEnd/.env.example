# Configuración General del Servidor
HOST=127.0.0.1
PORT=8000
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos
DATABASE_URL=sqlite:///./super_uce_doc.db

# API para Chatbot Médico (Opcional - Groq para RAG Gratuito)
# Obtén una gratis en https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Local LLM Config (Para traducción local de señas si se usa transformers)
QWEN_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
USE_LOCAL_LLM=False
