[Unit]
Description=SUPER-UCE DOC Backend Service (FastAPI Uvicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/super-uce-doc/BackEnd
ExecStart=/var/www/super-uce-doc/BackEnd/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8000
Restart=always
RestartSec=5
EnvironmentFile=/var/www/super-uce-doc/BackEnd/.env

[Install]
WantedBy=multi-user.target
