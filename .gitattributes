# Normalizar los saltos de línea (Line Endings) para evitar conflictos entre Windows y Mac/Linux
* text=auto eol=lf

# Excepciones para archivos binarios (imágenes, fuentes, pdfs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
